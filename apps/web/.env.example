# Copie para .env.local e preencha com os dados do projeto no Supabase
# (Project Settings > API). Nunca coloque a service_role key aqui.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Textos do produto por IA (opcional; sem ela o botão "Sugerir com IA" fica desligado).
# Chave da API da Anthropic (console.anthropic.com > API Keys). Só no servidor:
# nunca com o prefixo NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Pelo gateway de IA (opcional): o endereço compatível com a API da Anthropic e o token dele
# (vai como Authorization: Bearer). Com o gateway, use ANTHROPIC_AUTH_TOKEN ou ANTHROPIC_API_KEY,
# conforme o gateway pedir.
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=

# Fotos de catálogo por IA (opcional; sem ela a geração de fotos fica desligada).
# Chave da API da OpenAI (platform.openai.com > API keys). Só no servidor:
# nunca com o prefixo NEXT_PUBLIC_.
OPENAI_API_KEY=
# Reserva dos textos do produto: se o Claude (ou o gateway) falhar, a OpenAI escreve com a mesma
# chave acima e este modelo (nome exato do modelo na OpenAI; sem ele, não há reserva).
OPENAI_TEXT_MODEL=
